<circle class=3D"up-icon__mask up-icon__mask--hidden" cx=3D"32" cy=3D"32" r=
=3D"18"></circle></mask></defs><circle class=3D"up-icon__tint" cx=3D"32" cy=
=3D"32" r=3D"20"></circle><g class=3D"up-icon__strokes"><line class=3D"up-i=
con__stroke" x1=3D"32" x2=3D"32" y1=3D"24.5" y2=3D"39.5"></line><line class=
